#!/usr/bin/env python3
"""Operator-only R2 shadow activation; refuses unreviewed package paths."""
from pathlib import Path
import sys

PACKAGE = Path(__file__).resolve().parent / "bob_v08_package.pyz"
if PACKAGE.is_symlink() or not PACKAGE.is_file() or PACKAGE.stat().st_size > 512 * 1024:
    raise SystemExit("Bob v0.8 package is missing or unsafe")
sys.path.insert(0, str(PACKAGE))

if __name__ == "__main__":
    from bob_v08.install import main
    raise SystemExit(main())
