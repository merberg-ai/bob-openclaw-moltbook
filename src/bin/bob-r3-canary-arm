#!/usr/bin/env python3
"""Explicit owner-only one-time R3 public canary arming. NEVER sends HTTP.

Deployment is NOT arming. Queueing is NOT arming. After arming, the existing
publisher timer can make at most one real attempt against the single pinned
Bob-authored post, using its original credential owner and counted intent.
"""
from __future__ import annotations

from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import pwd
import stat
import sys

from bob_publish_common import DATA,connect
from bob_r313d_package import load_verified
from bob_r313d_owner import _verified_proposal,control_state,trusted_manager_boundary
from bob_r3_canary_lock import PIN,arm_path,expected_marker,matches_pin,marker_valid

RELEASE="v0.8.0-r3canary1"
CONFIRM="ARM BOB R3 "+PIN.run
REQUIRED_FILES=("bob-r3-canary-arm","bob_r3_canary_lock.py",
                "bob_r313c_adapter.py","bob-moltbook-publisher",
                "bob_r3_package.pyz")


def _signed_package() -> bool:
    """Exact private installed release registry and all canary writer hashes."""
    try:
        home=Path.home()
        uid=os.geteuid()
        if uid==0 or pwd.getpwuid(uid).pw_dir!=str(home):
            return False
        reg=home/".local/state/bob-updater/installed.json"
        info=reg.lstat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid!=uid
                or info.st_mode & 0o077 or info.st_nlink!=1
                or info.st_size>32768):
            return False
        item=json.loads(reg.read_text(encoding="utf-8"))
        if item.get("release")!=RELEASE or item.get("format")!="bob-updater-v1":
            return False
        for name in REQUIRED_FILES:
            path=home/".local/bin"/name
            meta=path.lstat()
            if (not stat.S_ISREG(meta.st_mode) or meta.st_uid!=uid
                    or meta.st_mode & 0o022 or meta.st_nlink!=1):
                return False
            expected=item["files"].get(name)
            if not isinstance(expected,str) or (
                    hashlib.sha256(path.read_bytes()).hexdigest()!=expected):
                return False
        return load_verified()=="verified_registry_archive"
    except (OSError,ValueError,TypeError,KeyError,ImportError):
        return False


def _can_arm(db, *, at: datetime) -> bool:
    if not trusted_manager_boundary(db):
        return False
    state=control_state(db)
    if state["schema"]!="ready" or not state["manual"] or state["automatic"]:
        return False
    try:
        action, _, seal, status=_verified_proposal(db,DATA,PIN.run)
        job=db.execute(
            "SELECT state,mode,attempted_at,post_id,draft_comment,"
            "approval_sha256 FROM publish_jobs WHERE run_id=?",
            (PIN.run,)).fetchone()
        if (job is None or (job[3],job[4],job[5])!=(
                PIN.target,action.text,PIN.seal)
                or action.target_id!=PIN.target):
            return False
        approval=db.execute(
            "SELECT seal_sha256,decision FROM r3_owner_approvals "
            "WHERE source_run=?", (PIN.run,)).fetchone()
        from bob_v08.r313c_candidate import _head
        # R3 must be the selected whole-queue manual head; this release
        # never authorizes sending an unrelated older legacy draft.
        if _head(db)!=PIN.run:
            return False
        previous=db.execute(
            "SELECT 1 FROM publish_jobs WHERE run_id<>? AND post_id=? "
            "AND attempted_at IS NOT NULL LIMIT 1",
            (PIN.run,PIN.target)).fetchone()
        if previous:
            return False
        return matches_pin(
            PIN,run=action.source_run,seal=seal,target=action.target_id,
            now=at,mode=job[1],proposal_state=status,
            queue_state=job[0],attempted_at=job[2],approval=approval)
    except (OSError,ValueError,TypeError,KeyError):
        return False


def inspect() -> bool:
    if not _signed_package():
        return False
    with connect() as db:
        return _can_arm(db,at=datetime.now(timezone.utc))


def arm() -> bool:
    """One local 0600 exclusive arm capability, created only after typed consent."""
    if not _signed_package():
        return False
    path=arm_path()
    if marker_valid(now=datetime.now(timezone.utc)) or path.exists() or path.is_symlink():
        return False
    parent=path.parent.lstat()
    if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid!=os.geteuid()
            or parent.st_mode & 0o077):
        return False
    with connect() as db:
        if not _can_arm(db,at=datetime.now(timezone.utc)):
            return False
        payload=(json.dumps(expected_marker(),sort_keys=True,
                            separators=(",",":"))+"\n").encode()
        fd=os.open(path,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
        try:
            with os.fdopen(fd,"wb") as file:
                file.write(payload)
                file.flush()
                os.fsync(file.fileno())
            # Do not restart or invoke publisher; its normal timer may act.
            return marker_valid(now=datetime.now(timezone.utc))
        except BaseException:
            # A partial marker must never become usable.
            path.unlink(missing_ok=True)
            raise


def main(argv=None) -> int:
    args=sys.argv[1:] if argv is None else argv
    if args==["--check"]:
        try:
            ready=inspect()
        except (OSError,ValueError,TypeError,KeyError):
            ready=False
        print("R3 EXACT CANARY ARM READINESS:",
              "READY_TO_ARM" if ready else "NOT_READY")
        print("No public send, no queue, no publisher invocation")
        return 0 if ready else 1
    if args!=["--arm"]:
        print("Usage: bob-r3-canary-arm [--check|--arm]")
        return 2
    if not sys.stdin.isatty():
        print("REFUSED: interactive owner terminal required")
        return 1
    try:
        if not inspect():
            print("REFUSED: sealed manual queue, trusted host or expiry not verified")
            return 1
        print("Only target",PIN.target,"and source",PIN.run)
        print("Expires:",PIN.expires_utc)
        print("WARNING: after arming, the EXISTING publisher timer may make")
        print("ONE real Moltbook comment attempt. Ambiguous responses never retry.")
        if input("Type "+CONFIRM+" to authorize ONE public attempt: ")!=CONFIRM:
            print("REFUSED: no owner approval to arm")
            return 1
        result=arm()
        print("R3 EXACT CANARY:", "ARMED" if result else "REFUSED")
        return 0 if result else 1
    except (OSError,ValueError,TypeError,KeyError):
        print("R3 EXACT CANARY: REFUSED")
        return 1


if __name__=="__main__":
    raise SystemExit(main())
